{
  "target_version": "v0.107.1",
  "source_commit": "5d874e855ae1d0550d5c30416fadd7dbb0d133b7",
  "scope": "Source-reviewed single-player callback ordering and pre-application modifier outcomes. Independently implemented projections; no bundled game source and no live executable equivalence claim.",
  "facts": {
    "PaelsEye": "Completed manual card plays disqualify the extra turn; automatic/replayed cards do not. WhisperingEarring disqualifies only turn one. Exhaust a snapshot of the hand in Early before orb passives/hand effects.",
    "ToastyMittens": "BeforeHandDraw follows turn-start powers, including DemonForm Strength and Helmet receipt modification. Shuffle an empty draw pile if possible, then choose first non-Innate on turn one (fallback first), exhaust with callbacks, apply one Strength.",
    "UnceasingTop": "Check after complete card or potion execution, outside parent effects. AutoPrePlay/Play/AutoPostPlay are valid phases; Start/End are invalid.",
    "UnsettlingLamp": "First attempted visible enemy debuff with owner giver and card source locks that card. Double that first play\u2019s remaining debuff applications on every target before Artifact. Flattened temporary stat representation applies its debuff once, avoiding internal quadrupling.",
    "RuinedHelmet": "Double first positive received Strength independent of giver, before storage cap; consume once per combat.",
    "SneckoSkull": "Owner-given Poison receives additive one before multiplicative Lamp and Artifact.",
    "Imbued": "Opening normal hand draw precedes AutoPrePlay; no energy is spent for its autoplay.",
    "DiamondDiadem": "All completed owner card plays, including AutoPost, count before its regular BeforeSideTurnEnd check.",
    "ConsumingShadow": "AfterSideTurnEnd follows normal orb passives and hand flush; Hailstorm is regular BeforeSideTurnEnd and requires at least one Frost orb."
  },
