+    // These opaque IDs correlate physical objects across captures; they do not alter game models.
+    private sealed class BridgeCardIdentity
+    {
+        public string Value { get; } = "live-card-" + Interlocked.Increment(ref _bridgeCardSequence);
+    }
+    private static long _bridgeCardSequence;
+    private static readonly ConditionalWeakTable<CardModel, BridgeCardIdentity> _bridgeCardIds = new();
+    private static string BridgeCardId(CardModel card)
+        => _bridgeCardIds.GetValue(card, _ => new BridgeCardIdentity()).Value;
+
+    private static List<Dictionary<string, object?>> BuildBridgeCostModifiers(CardModel card)
+    {
+        var rows = new List<Dictionary<string, object?>>();
+        if (GetInstanceFieldValue(card.EnergyCost, "_localModifiers") is IEnumerable<LocalCostModifier> modifiers)
+        {
+            foreach (var modifier in modifiers)
+                rows.Add(new Dictionary<string, object?>
+                {
+                    ["amount"] = modifier.Amount,
+                    ["type"] = modifier.Type.ToString(),
+                    ["expiration"] = modifier.Expiration.ToString(),
+                    ["reduce_only"] = modifier.IsReduceOnly
+                });
+        }
+        return rows;
+    }
+
+    private static List<Dictionary<string, object?>> BuildBridgeTemporaryStarCosts(CardModel card)
+    {
+        var rows = new List<Dictionary<string, object?>>();
+        if (GetInstanceFieldValue(card, "_temporaryStarCosts") is IEnumerable<TemporaryCardCost> costs)
+        {
+            foreach (var cost in costs)
+                rows.Add(new Dictionary<string, object?>
+                {
+                    ["cost"] = cost.Cost,
+                    ["clears_when_turn_ends"] = cost.ClearsWhenTurnEnds,
+                    ["clears_when_card_is_played"] = cost.ClearsWhenCardIsPlayed
+                });
+        }
+        return rows;
+    }
+
+    private static WeakReference<RunState>? _bridgeValidationRun;
+    private static readonly Dictionary<string, MegaCrit.Sts2.Core.Random.Rng> _bridgeEventRngs = new();
+    private static Dictionary<string, object?> BuildBridgeValidationState(RunState runState)
+    {
+        if (_bridgeValidationRun == null || !_bridgeValidationRun.TryGetTarget(out var previousRun)
+            || !ReferenceEquals(previousRun, runState))
+        {
+            _bridgeValidationRun = new WeakReference<RunState>(runState);
+            _bridgeEventRngs.Clear();
+        }
+        var counters = new Dictionary<string, object?>
+        {
+            ["schema_version"] = 1,
+            ["run_rng"] = runState.Rng.ToSerializable(),
+            ["run_odds"] = runState.Odds.ToSerializable(),
+            ["players_saved_state"] = runState.Players.Select(player => new Dictionary<string, object?>
+            {
+                ["slot"] = runState.GetPlayerSlotIndex(player),
+                ["odds"] = player.PlayerOdds.ToSerializable(),
+                ["relics"] = player.Relics.Select(relic => relic.ToSerializable()).ToList()
+            }).ToList(),
+            ["players_rng"] = runState.Players.Select(player => new Dictionary<string, object?>
+            {
+                ["slot"] = runState.GetPlayerSlotIndex(player),
+                ["rng"] = player.PlayerRng.ToSerializable()
+            }).ToList()
+        };
+        // Native draw order and model RNG are oracle evidence, never policy input.
+        var localPlayer = LocalContext.GetMe(runState);
+        if (localPlayer?.PlayerCombatState != null && CombatManager.Instance.IsInProgress)
+            counters["draw_order"] = BuildPileCardList(localPlayer.PlayerCombatState.DrawPile.Cards, PileType.Draw);
+        try
+        {
+            if (runState.CurrentRoom is EventRoom eventRoom && eventRoom.LocalMutableEvent is EventModel model)
+            {
+                _bridgeEventRngs[model.Id.Entry] = model.Rng;
+                counters["event_rng"] = new Dictionary<string, object?>
+                {
+                    ["id"] = model.Id.Entry, ["seed"] = model.Rng.Seed, ["counter"] = model.Rng.Counter
+                };
+            }
+        }
+        catch (Exception exception)
+        {
+            // Transitional event screens remain capturable; validation sees the missing evidence.
+            counters["event_rng_error"] = exception.GetType().Name;
+        }
+        // Keep references to observed event RNGs across event completion so the final draw is capturable.
+        counters["event_rngs"] = _bridgeEventRngs.ToDictionary(pair => pair.Key,
+            pair => new Dictionary<string, object?>
+            {
+                ["seed"] = pair.Value.Seed, ["counter"] = pair.Value.Counter
+            });
+        return counters;
+    }
+
