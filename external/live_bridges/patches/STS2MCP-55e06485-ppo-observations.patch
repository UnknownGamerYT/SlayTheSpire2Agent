+    private static Dictionary<string, object?> ExecuteCardRewardAlternative(Dictionary<string, JsonElement> data)
+    {
+        if (NOverlayStack.Instance?.Peek() is not NCardRewardSelectionScreen screen)
+            return Error("Card reward selection screen is not open");
+        if (!data.TryGetValue("index", out var value) || !value.TryGetInt32(out int index))
+            return Error("Missing or invalid alternative index");
+        var alternatives = BridgeRewardAlternatives(screen);
+        var buttons = BridgeRewardAlternativeButtons(screen);
+        if (alternatives.Count != buttons.Count || index < 0 || index >= alternatives.Count)
+            return Error("Card reward alternative index is unavailable");
+        var button = buttons[index];
+        if (!button.IsEnabled || !IsNodeVisible(button))
+            return Error("Card reward alternative is disabled");
+        button.ForceClick();
+        return new Dictionary<string, object?>
+        {
+            ["status"] = "ok", ["alternative_id"] = alternatives[index].OptionId
+        };
+    }
